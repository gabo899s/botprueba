# Copia de referencia. npm run setup crea .env con secretos aleatorios.
PORT=3000
BASE_URL=http://localhost:3000
# Para acceso autenticado desde otra máquina: BASE_URL=https://tu-dominio y HTTPS.
# LISTEN_HOST=0.0.0.0 solo si necesitas escuchar directamente en otras interfaces.
LISTEN_HOST=127.0.0.1
JWT_SECRET=
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
POLICE_ROLE_IDS=
LICENSE_ROLE_MAP={}
MULTA_CHANNEL_ID=
ARRESTO_CHANNEL_ID=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
# Opcional: respaldo de perfiles y fotos, nunca una cookie .ROBLOSECURITY.
COOKIE_API_KEY=
ADMIN_GUILD_ID=
ADMIN_ROLE_IDS=
PRC_SERVER_KEY=
PRC_AUTH_KEY=
UNBELIEVABOT_TOKEN=

# Información pública del responsable. Completar antes de abrir el servicio.
LEGAL_OWNER_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_JURISDICTION=

# Roles opcionales de módulos ciudadanos (vacíos: ocultos)
DOT_ROLE_IDS=
FIRE_ROLE_IDS=
GANG_ROLE_IDS=
